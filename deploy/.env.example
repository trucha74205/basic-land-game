# Copy to deploy/.env on the Pi. Never commit the real file (D-07).
TAG=latest
PUBLIC_URL=https://pauli.mywire.org:1701
CONTACT_EMAIL=you@example.com
# npx web-push generate-vapid-keys   (generate once and keep; changing them drops all push subscriptions, O-01)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TRUST_PROXY=true
IMAGE_CACHE_MAX_MB=1024
# optional
# AUTO_PASS_MIN_MS=1000
# AUTO_PASS_MAX_MS=3000
# FINISHED_RETENTION_DAYS=30
# IDLE_RETENTION_DAYS=14
